if @wiki_extension_data && WikiExtensionsUtil.draft_create?(@project, @wiki_extension_data[:setting])

    # disabled, approval_required or approval_version_required
    disabled = @wiki_extension_data[:setting].approval_required || 
               (@wiki_extension_data[:setting].approval_version_required && @wiki_extension_data[:latest_public_approval]&.released?)

    # default, same as disabled OR current in pending/rejected approval
    default = disabled ||
              (@wiki_extension_data[:approval] && @wiki_extension_data[:approval].status.in?(%w[pending rejected draft]))

    status_hidden = disabled ? "draft" : "published"

-%>
    <p id="wiki_extensions_draft_form">
        <label><%= l("wiki_extensions_approval.status.draft") %></label>
        <%= hidden_field_tag 'status_disabled', disabled %>
        <%= hidden_field_tag 'status', status_hidden %>
        <%= check_box_tag 'status', "draft", default, disabled: disabled %>
    </p>
    <script type="text/javascript">
        //<![CDATA'
        add_wiki_extensions_edit_form('#wiki_extensions_draft_form');
        //]]>
    </script>

<% end %>