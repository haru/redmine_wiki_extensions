  return if @wiki_extension_data.nil?

  if @wiki_extension_data[:approval] && 
     ((@wiki_extension_data[:latest_public_approval] && @wiki_extension_data[:latest_public_approval].wiki_version_id == @wiki_extension_data[:view_version_id]) ||
      (@page.version == @wiki_extension_data[:view_version_id]))
-%>
    <h3><%= l(:label_wiki_extensions_approval_workflow) %></h3>
    <div>
      <ul>
        <li style="font-size: 0.9em; margin-bottom: 5px;"><%= l("wiki_extensions_approval.status.#{@wiki_extension_data[:approval].status}") %>: vor <%= time_ago_in_words(@wiki_extension_data[:approval].created_at) %></li>
        <li style="display: flex; align-items: center; gap: 10px; margin: 5px 5px;">
          <%= avatar(@wiki_extension_data[:approval].author, :size => 16, :title => @wiki_extension_data[:approval].author.name) %> 
          <div><%= @wiki_extension_data[:approval].author.name %></div>
          <div style="font-size: 0.85em; color: #888;">Autor</div>
      </ul>
    </div>
  <% end %>

  <% if @wiki_extension_data[:latest_public_approval] && @wiki_extension_data[:latest_public_approval].wiki_version_id == @wiki_extension_data[:view_version_id] %>
    
    <% content_for :header_tags do %>
      <script>
        document.addEventListener('DOMContentLoaded', function () {
          hide_wiki_history_tags();
        });
      </script>
    <% end %>

  <% end %>



