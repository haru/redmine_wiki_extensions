if @wiki_extension_data && WikiExtensionsUtil.approval_or_draft_enabled?(@project, @wiki_extension_data&.dig(:setting))

    if @wiki_extension_data[:approval] && 
        ((@wiki_extension_data[:latest_public_approval] && @wiki_extension_data[:latest_public_approval].wiki_version_id == @wiki_extension_data[:view_version_id]) ||
        (@page.version == @wiki_extension_data[:view_version_id]))
    -%>

        <% if @page.version == @wiki_extension_data[:view_version_id] && @wiki_extension_data[:latest_public_approval] && @wiki_extension_data[:latest_public_approval].wiki_version_id < @page.version && User.current.allowed_to?(:view_wiki_edits, @project) %>
            <%= link_to sprite_icon('wiki-page', l(:wiki_extensions_approval_link_release)), 
                        { controller: 'wiki', action: 'show', project_id: @project.identifier, id: @page.title, version: @wiki_extension_data[:latest_public_approval].wiki_version_id }, 
                        { title: "Autor #{@wiki_extension_data[:approval].author.name} · vor etwa #{time_ago_in_words(@wiki_extension_data[:approval].created_at)}", 
                        class: 'icon icon-workflows' } %> 
            
        <% end %>
        <% if @wiki_extension_data[:view_version_id] < @page.version %>
            <%= watcher_link(@page, User.current) %>
        <% end %>
        <% if @wiki_extension_data[:view_version_id] < @page.version && WikiExtensionsUtil.view_draft?(@project, @wiki_extension_data&.dig(:setting)) %>
            <%= link_to sprite_icon('wiki-page', l(:wiki_extensions_approval_link_draft)), 
                        { controller: 'wiki', action: 'show', id: @page.title, version: @page.version }, 
                        { title: "Autor #{@wiki_extension_data[:approval].author.name} · vor etwa #{time_ago_in_words(@wiki_extension_data[:approval].created_at)}", 
                        class: 'icon icon-workflows' } %>
            
        <% end %>

        <span class="badge <%= WikiExtensionsUtil.wiki_extensions_approval_badge(@wiki_extension_data[:approval].status) %>" style="bottom: 0px"><%= l("wiki_extensions_approval.status.#{@wiki_extension_data[:approval].status}") %></span>

    <% end %>

    <% if @wiki_extension_data[:latest_public_approval] && @wiki_extension_data[:latest_public_approval].wiki_version_id == @wiki_extension_data[:view_version_id] %>

        <% content_for :header_tags do %>
            <script>
            document.addEventListener('DOMContentLoaded', function () {
                hide_wiki_history_tags();
            });
            </script>
        <% end %>

    <% end %>
<% end %>
