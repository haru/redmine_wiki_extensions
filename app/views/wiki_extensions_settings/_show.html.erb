<script type="text/javascript">
function click_wiki_menu_tab(num) {
  var checked = $('#menus_' + num + '_enabled').is(':checked');
  var menu_title = $('#menus_' + num + '_title');
  var menu_page_name = $('#menus_' + num + '_page_name');
  if (checked){
    menu_title.removeAttr("disabled");;
    menu_page_name.removeAttr("disabled");;
  }else{
    menu_title.attr("disabled", "disabled");;
    menu_page_name.attr("disabled", "disabled");;
  }
}
</script>

<div id="wiki_extensions_settings">
<%
    @wiki_extensions_setting = WikiExtensionsSetting.find_or_create(@project.id)
%>

<%= labelled_form_for :setting, @wiki_extensions_setting,
                             :url => {:controller => 'wiki_extensions_settings',
                             :action => 'update', :id => @project, :tab => 'wiki_extensions',
                             :partial => 'wiki_extensions_settings/update',
                             :setting_id => @wiki_extensions_setting.id} do |f| %>
    <%= error_messages_for 'wiki_extensions_setting' %>

    <fieldset class="box tabular settings">
      <legend><%= l(:label_settings) %></legend>
      <% if Setting.plugin_redmine_wiki_extensions['wiki_extensions_settings_comment'] == SettingsHelper::PROJECT %>
      <p>  
        <label><%= l(:label_wiki_extensions_settings_comment) %></label>
        <%= hidden_field_tag 'comment_required', '0' %>
        <%= check_box_tag 'comment_required', '1', @wiki_extensions_setting.comment_required %>
      </p>
      <% end %>
      <% if Setting.plugin_redmine_wiki_extensions['wiki_extensions_settings_draft_enabled'] == SettingsHelper::PROJECT %>
      <p>
        <label><%= l(:label_wiki_extensions_settings_draft_enabled) %></label>
        <%= hidden_field_tag 'draft_enabled', '0' %>
        <%= check_box_tag 'draft_enabled', '1', @wiki_extensions_setting.draft_enabled %>
      </p>
      <% end %>
      <% if Setting.plugin_redmine_wiki_extensions['wiki_extensions_settings_approval_enabled'] == SettingsHelper::PROJECT %>
      <p>
        <label><%= l(:label_wiki_extensions_settings_approval_enabled) %></label>
        <%= hidden_field_tag 'approval_enabled', '0' %>
        <%= check_box_tag 'approval_enabled', '1', @wiki_extensions_setting.approval_enabled, id: 'approval_enabled_box' %>
      </p>
      <% end %>
      <div style="margin-left: 20px;">
      <% if Setting.plugin_redmine_wiki_extensions['wiki_extensions_settings_approval'] == SettingsHelper::PROJECT %>
      <p>
        <label><%= l(:label_wiki_extensions_settings_approval) %></label>
        <%= hidden_field_tag 'approval_required', '0' %>
        <%= check_box_tag 'approval_required', '1', @wiki_extensions_setting.approval_required, id: 'approval_required_box' %>
      </p>
      <% end %>
      <% if Setting.plugin_redmine_wiki_extensions['wiki_extensions_settings_approval_version'] == SettingsHelper::PROJECT %>
      <p>
        <label><%= l(:label_wiki_extensions_settings_approval_version) %></label>
        <%= hidden_field_tag 'approval_version_required', '0' %>
        <%= check_box_tag 'approval_version_required', '1', @wiki_extensions_setting.approval_version_required, id: 'approval_version_required_box' %>
        <em class="info"><%= t(:text_wiki_extensions_settings_approval_version) %></em>
      </p>
      <% end %>
      </div>
      <% if Setting.plugin_redmine_wiki_extensions['wiki_extensions_settings_tags'] == SettingsHelper::PROJECT %>
      <p>
        <label><%= l(:label_wiki_extensions_settings_tags) %></label>
        <%= hidden_field_tag 'tag_disabled', '0' %>
        <%= check_box_tag 'tag_disabled', '1', @wiki_extensions_setting.tag_disabled %>
      </p>
      <% end %>
      
    </fieldset>
    <fieldset class="box tabular settings">
      <legend><%= l(:wiki_extensions_add_tab)%></legend>
      <%= render :partial => "wiki_extensions_settings/menu", :collection => @wiki_extensions_setting.menus, :as => :menu %>
    </fieldset>
    <%= submit_tag l(:button_update) %>
<% end %>
</div>


<script>
  document.addEventListener('DOMContentLoaded', function() {
    const mainCheckbox = document.getElementById('approval_enabled_box');
    const dependentCheckboxes = [
      document.getElementById('approval_required_box'),
      document.getElementById('approval_version_required_box')
    ];

    function toggleDependentCheckboxes() {
      const isDisabled = !mainCheckbox.checked;
      dependentCheckboxes.forEach(cb => {
        cb.disabled = isDisabled;
        if (isDisabled) cb.checked = false;
      });
    }

    mainCheckbox.addEventListener('change', toggleDependentCheckboxes);
    toggleDependentCheckboxes();
  });
</script>
